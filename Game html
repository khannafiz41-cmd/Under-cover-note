<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Undercover Notes - Partie</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: #080c18;
      color: white;
      font-family: Arial, sans-serif;
    }

    main {
      width: 100%;
      max-width: 600px;
      margin: auto;
      padding: 30px 18px 50px;
    }

    h1 {
      text-align: center;
      margin-bottom: 25px;
    }

    .card {
      background: #111a2e;
      border: 1px solid #293653;
      border-radius: 18px;
      padding: 25px;
      margin: 15px 0;
      text-align: center;
    }

    #status {
      padding: 12px;
      border-radius: 12px;
      background: #18233a;
      text-align: center;
      line-height: 1.5;
    }

    .success {
      color: #86efac;
    }

    .error {
      color: #fca5a5;
    }

    .code {
      font-size: 38px;
      font-weight: bold;
      letter-spacing: 7px;
      margin: 20px 0;
    }

    .info {
      color: #cbd5e1;
      line-height: 1.6;
    }

    button {
      width: 100%;
      padding: 15px;
      margin-top: 15px;
      border: 0;
      border-radius: 12px;
      background: #7c3aed;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button.secondary {
      background: #18233a;
      border: 1px solid #293653;
    }
  </style>
</head>

<body>

<main>

  <h1>🕵️ Undercover Notes</h1>

  <div id="status">
    Chargement de la partie...
  </div>

  <div class="card">

    <h2>🎮 La partie commence !</h2>

    <div id="gameCode" class="code">
      ----
    </div>

    <p id="playerName" class="info">
      Chargement...
    </p>

    <p class="info">
      Tous les joueurs sont prêts.
    </p>

  </div>

  <button
    id="backButton"
    class="secondary"
  >
    ← Retour au lobby
  </button>

</main>


<!-- SUPABASE -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>

const SUPABASE_URL =
  "https://sarszeuyxrozsljhgyos.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_K_iSNYX03boGTMYWG07hfQ_TjG0FaaA";


const supabaseClient =
  window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );


const params =
  new URLSearchParams(
    window.location.search
  );


const gameId =
  params.get("game");


const playerId =
  params.get("player");


const statusElement =
  document.getElementById("status");


const gameCodeElement =
  document.getElementById("gameCode");


const playerNameElement =
  document.getElementById("playerName");


let realtimeChannel = null;


function setStatus(
  message,
  type = ""
) {

  statusElement.textContent =
    message;

  statusElement.className =
    type;

}


/* =========================
   CHARGER LA PARTIE
========================= */

async function loadGame() {

  if (!gameId) {

    setStatus(
      "❌ Aucune partie sélectionnée.",
      "error"
    );

    return;

  }

  try {

    const {
      data: game,
      error
    } =
      await supabaseClient
        .from("games")
        .select("*")
        .eq("id", gameId)
        .maybeSingle();


    if (error) {
      throw error;
    }


    if (!game) {

      setStatus(
        "❌ Partie introuvable.",
        "error"
      );

      return;

    }


    gameCodeElement.textContent =
      game.code;


    if (playerId) {

      const {
        data: player
      } =
        await supabaseClient
          .from("players")
          .select("*")
          .eq("id", playerId)
          .maybeSingle();


      if (player) {

        playerNameElement.textContent =
          "👤 Joueur : " +
          player.name;

      }

    }


    if (game.status === "playing") {

      setStatus(
        "✅ Partie en cours",
        "success"
      );

    } else {

      setStatus(
        "⏳ En attente du lancement..."
      );

    }


    subscribeToGame();


  } catch (error) {

    console.error(error);

    setStatus(
      "❌ Erreur : " +
      error.message,
      "error"
    );

  }

}


/* =========================
   TEMPS RÉEL
========================= */

function subscribeToGame() {

  if (realtimeChannel) {

    supabaseClient.removeChannel(
      realtimeChannel
    );

  }


  realtimeChannel =
    supabaseClient
      .channel(
        "game-page-" + gameId
      )

      .on(
        "postgres_changes",
        {
          event: "UPDATE",
          schema: "public",
          table: "games",
          filter:
            "id=eq." + gameId
        },
        function(payload) {

          console.log(
            "Modification de la partie :",
            payload.new
          );


          if (
            payload.new.status ===
            "playing"
          ) {

            setStatus(
              "✅ Partie en cours",
              "success"
            );

          }

        }
      )

      .subscribe(
        function(channelStatus) {

          console.log(
            "Realtime game :",
            channelStatus
          );

        }
      );

}


/* =========================
   RETOUR
========================= */

document
  .getElementById("backButton")
  .addEventListener(
    "click",
    function() {

      if (gameId) {

        window.location.href =
          "index-multiplayer.html?game=" +
          encodeURIComponent(gameId);

      } else {

        window.location.href =
          "index-multiplayer.html";

      }

    }
  );


/* =========================
   DÉMARRAGE
========================= */

loadGame();

</script>

</body>
</html>
