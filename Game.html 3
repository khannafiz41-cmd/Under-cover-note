const hostNextButton =
  document.getElementById("hostNextButton");


/* =========================================================
   STATUS
========================================================= */

function setStatus(
  message,
  type = ""
) {

  statusElement.textContent =
    message;

  statusElement.className =
    type;

}


/* =========================================================
   PHASE
========================================================= */

function setPhase(
  title,
  description
) {

  phaseTitle.textContent =
    title;

  phaseDescription.textContent =
    description;

}


/* =========================================================
   CHARGER LA PARTIE
========================================================= */

async function loadGame() {

  if (!gameId || !playerId) {

    setStatus(
      "❌ Informations de partie manquantes.",
      "error"
    );

    return;

  }


  try {

    const {
      data: game,
      error: gameError
    } =
      await supabaseClient
        .from("games")
        .select("*")
        .eq(
          "id",
          gameId
        )
        .maybeSingle();


    if (gameError) {
      throw gameError;
    }


    if (!game) {

      throw new Error(
        "Partie introuvable."
      );

    }


    const {
      data: player,
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .select("*")
        .eq(
          "id",
          playerId
        )
        .eq(
          "game_id",
          gameId
        )
        .maybeSingle();


    if (playerError) {
      throw playerError;
    }


    if (!player) {

      throw new Error(
        "Joueur introuvable."
      );

    }


    currentGame =
      game;

    currentPlayer =
      player;


    await loadPlayers();


    loadingSection.classList.add(
      "hidden"
    );

    gameSection.classList.remove(
      "hidden"
    );


    renderGame();


    subscribeRealtime();


  } catch (error) {

    console.error(error);

    setStatus(
      "❌ " +
      error.message,
      "error"
    );

  }

}


/* =========================================================
   CHARGER JOUEURS
========================================================= */

async function loadPlayers() {

  const {
    data,
    error
  } =
    await supabaseClient
      .from("players")
      .select("*")
      .eq(
        "game_id",
        gameId
      )
      .order(
        "created_at",
        {
          ascending: true
        }
      );


  if (error) {

    console.error(
      "Erreur joueurs :",
      error
    );

    return;

  }


  players =
    data || [];

}


/* =========================================================
   INITIALISER LA PARTIE
========================================================= */

async function initializeGame() {

  /*
    Seul l'hôte initialise les rôles.
  */

  if (
    !currentPlayer ||
    !currentPlayer.is_host
  ) {
    return;
  }


  /*
    Si des rôles existent déjà,
    on ne recommence pas.
  */

  const alreadyAssigned =
    players.some(function(player) {

      return (
        player.role === "villager" ||
        player.role === "undercover"
      );

    });


  if (alreadyAssigned) {
    return;
  }


  const playerCount =
    players.length;


  const undercoverCount =
    Math.min(
      Math.max(
        Number(
          currentGame.undercover_count || 1
        ),
        1
      ),
      Math.max(
        playerCount - 1,
        1
      )
    );


  /*
    Mélange des joueurs.
  */

  const shuffled =
    [...players].sort(
      () => Math.random() - 0.5
    );


  const undercoverIds =
    shuffled
      .slice(
        0,
        undercoverCount
      )
      .map(
        player => player.id
      );


  /*
    Attribution des rôles + notes.
  */

  for (
    const player of players
  ) {

    const isUndercover =
      undercoverIds.includes(
        player.id
      );


    const normalNote =
      Number(
        currentGame.normal_note || 5
      );


    const undercoverNote =
      Number(
        currentGame.undercover_note ||
        Math.max(
          normalNote - 1,
          1
        )
      );


    const note =
      isUndercover
        ? undercoverNote
        : normalNote;


    const {
      error
    } =
      await supabaseClient
        .from("players")
        .update({

          role:
            isUndercover
              ? "undercover"
              : "villager",

          note: note,

          secret_note:
            isUndercover
              ? undercoverNote
              : null,

          alive: true,

          eliminated: false,

          revealed: false,

          vote_for: null

        })
        .eq(
          "id",
          player.id
        )
        .eq(
          "game_id",
          gameId
        );


    if (error) {

      console.error(
        "Erreur attribution :",
        error
      );

      setStatus(
        "❌ Impossible d'attribuer les rôles : " +
        error.message,
        "error"
      );

      return;

    }

  }


  /*
    La première phase devient discussion.
  */

  const {
    error: gameUpdateError
  } =
    await supabaseClient
      .from("games")
      .update({

        phase: "discussion",

        current_round: 1,

        round: 1,

        status: "playing",

        winner: null,

        updated_at:
          new Date().toISOString()

      })
      .eq(
        "id",
        gameId
      );


  if (gameUpdateError) {

    console.error(
      gameUpdateError
    );

  }

}


/* =========================================================
   AFFICHER LE JEU
========================================================= */

function renderGame() {

  if (!currentGame || !currentPlayer) {
    return;
  }


  const phase =
    currentGame.phase ||
    "discussion";


  /*
    NOTE
  */

  if (
    currentPlayer.role ===
      "villager" ||
    currentPlayer.role ===
      "undercover"
  ) {

    noteCard.classList.remove(
      "hidden"
    );


    myNote.textContent =
      currentPlayer.note ??
      "?";


    if (
      currentPlayer.role ===
      "undercover"
    ) {

      roleDisplay.textContent =
        "🕵️ UNDERCOVER";

      secretNoteBox.classList.remove(
        "hidden"
      );

      secretNote.textContent =
        currentPlayer.secret_note ??
        currentPlayer.note ??
        "?";

    } else {

      roleDisplay.textContent =
        "👤 VILLAGEOIS";

      secretNoteBox.classList.add(
        "hidden"
      );

    }

  }


  /*
    AFFICHAGE PHASE
  */

  discussionCard.classList.add(
    "hidden"
  );

  voteCard.classList.add(
    "hidden"
  );

  resultCard.classList.add(
    "hidden"
  );

  winnerCard.classList.add(
    "hidden"
  );


  if (phase === "discussion") {

    showDiscussion();

  }


  else if (phase === "voting") {

    showVoting();

  }


  else if (phase === "result") {

    showResult();

  }


  else if (phase === "ended") {

    showWinner();

  }


  renderPlayers();


  /*
    Contrôles hôte.
  */

  if (
    currentPlayer.is_host
  ) {

    hostControls.classList.remove(
      "hidden"
    );

  } else {

    hostControls.classList.add(
      "hidden"
    );

  }

}


/* =========================================================
   DISCUSSION
========================================================= */

function showDiscussion() {

  setPhase(
    "💬 Discussion",
    "Discutez ensemble et essayez de trouver l'Undercover."
  );


  discussionCard.classList.remove(
    "hidden"
  );


  if (
    currentPlayer.is_host
  ) {

    goVoteButton.classList.remove(
      "hidden"
    );

  } else {

    goVoteButton.classList.add(
      "hidden"
    );

  }


  hostVoteButton.classList.remove(
    "hidden"
  );

  resolveButton.classList.add(
    "hidden"
  );

  hostNextButton.classList.add(
    "hidden"
  );

}


/* =========================================================
   PASSER AU VOTE
========================================================= */

async function startVoting() {

  if (
    !currentPlayer.is_host
  ) {
    return;
  }


  const {
    error
  } =
    await supabaseClient
      .from("players")
      .update({
        vote_for: null
      })
      .eq(
        "game_id",
        gameId
      )
      .eq(
        "alive",
        true
      );


  if (error) {

    setStatus(
      "❌ " + error.message,
      "error"
    );

    return;

  }


  const {
    error: gameError
  } =
    await supabaseClient
      .from("games")
      .update({

        phase: "voting",

        updated_at:
          new Date().toISOString()

      })
      .eq(
        "id",
        gameId
      );


  if (gameError) {

    setStatus(
      "❌ " +
      gameError.message,
      "error"
    );

  }

}


goVoteButton.addEventListener(
  "click",
  startVoting
);


hostVoteButton.addEventListener(
  "click",
  startVoting
);


/* =========================================================
   VOTE
========================================================= */

function showVoting() {

  setPhase(
    "🗳️ Vote",
    "Choisis une seule personne."
  );


  voteCard.classList.remove(
    "hidden"
  );


  discussionCard.classList.add(
    "hidden"
  );


  selectedVote =
    currentPlayer.vote_for ||
    null;


  renderVoteList();


  updateVoteButton();


  hostVoteButton.classList.add(
    "hidden"
  );


  /*
    L'hôte peut terminer les votes
    lorsque tout le monde a voté.
  */

  if (
    currentPlayer.is_host
  ) {

    resolveButton.classList.remove(
      "hidden"
    );

  }

}


function renderVoteList() {

  voteList.innerHTML = "";


  players
    .filter(function(player) {

      return (
        player.alive &&
        player.id !== currentPlayer.id
      );

    })
    .forEach(function(player) {


      const row =
        document.createElement(
          "div"
        );


      row.className =
        "player";


      const name =
        document.createElement(
          "span"
        );


      name.className =
        "player-name";


      name.textContent =
        "👤 " +
        player.name;


      const button =
        document.createElement(
          "button"
        );


      button.className =
        "vote-button";


      button.textContent =
        selectedVote === player.id
          ? "✓ Choisi"
          : "Voter";


      if (
        selectedVote ===
        player.id
      ) {

        button.classList.add(
          "selected"
        );

      }


      button.addEventListener(
        "click",
        function() {

          selectedVote =
            player.id;

          renderVoteList();

          updateVoteButton();

        }
      );


      row.appendChild(
        name
      );

      row.appendChild(
        button
      );


      voteList.appendChild(
        row
      );

    });

}


function updateVoteButton() {

  confirmVoteButton.disabled =
    !selectedVote;


  if (selectedVote) {

    confirmVoteButton.textContent =
      "✅ Confirmer mon vote";

  } else {

    confirmVoteButton.textContent =
      "Choisis un joueur";

  }

}


confirmVoteButton.addEventListener(
  "click",
  submitVote
);


async function submitVote() {

  if (!selectedVote) {
    return;
  }


  confirmVoteButton.disabled =
    true;


  const {
    error
  } =
    await supabaseClient
      .from("players")
      .update({

        vote_for:
          selectedVote

      })
      .eq(
        "id",
        currentPlayer.id
      )
      .eq(
        "game_id",
        gameId
      );


  if (error) {

    confirmVoteButton.disabled =
      false;

    setStatus(
      "❌ Impossible d'enregistrer le vote : " +
      error.message,
      "error"
    );

    return;

  }


  currentPlayer.vote_for =
    selectedVote;


  setStatus(
    "✅ Vote enregistré.",
    "success"
  );


  confirmVoteButton.textContent =
    "✅ Vote enregistré";


  await loadPlayers();

  renderPlayers();

}


/* =========================================================
   AFFICHER LES JOUEURS
========================================================= */

function renderPlayers() {

  playersList.innerHTML = "";


  players.forEach(function(player) {

    const row =
      document.createElement(
        "div"
      );


    row.className =
      "player";


    if (
      player.alive === false ||
      player.eliminated === true
    ) {

      row.classList.add(
        "eliminated"
      );

    }


    const name =
      document.createElement(
        "span"
      );


    name.className =
      "player-name";


    let text =
      "👤 " +
      player.name;


    if (
      player.id ===
      currentPlayer.id
    ) {

      text +=
        " (toi)";

    }


    if (
      player.is_host
    ) {

      text +=
        " 👑";

    }


    if (
      player.alive === false
    ) {

      text +=
        " ❌";

    }


    name.textContent =
      text;


    row.appendChild(
      name
    );


    playersList.appendChild(
      row
    );

  });

}


/* =========================================================
   VÉRIFIER TOUS LES VOTES
========================================================= */

function allPlayersVoted() {

  const alivePlayers =
    players.filter(
      player =>
        player.alive !== false
    );


  return alivePlayers.every(
    player =>
      player.vote_for
  );

}


/* =========================================================
   TERMINER LES VOTES
========================================================= */

async function resolveVotes() {

  if (
    !currentPlayer.is_host
  ) {
    return;
  }


  await loadPlayers();


  if (!allPlayersVoted()) {

    const aliveCount =
      players.filter(
        player =>
          player.alive !== false
      ).length;


    const votedCount =
      players.filter(
        player =>
          player.alive !== false &&
          player.vote_for
      ).length;


    setStatus(
      `⏳ ${votedCount}/${aliveCount} joueurs ont voté.`,
      ""
    );

    return;

  }


  /*
    Compter les votes.
  */

  const voteCounts = {};


  players
    .filter(
      player =>
        player.alive !== false
    )
    .forEach(function(player) {

      const vote =
        player.vote_for;


      if (!vote) {
        return;
      }


      voteCounts[vote] =
        (voteCounts[vote] || 0) + 1;

    });


  const candidates =
    Object.keys(
      voteCounts
    );


  if (!candidates.length) {

    return;

  }


  let maxVotes =
    0;


  candidates.forEach(
    function(id) {

      maxVotes =
        Math.max(
          maxVotes,
          voteCounts[id]
        );

    }
  );


  const winners =
    candidates.filter(
      id =>
        voteCounts[id] ===
        maxVotes
    );


  /*
    Égalité :
    personne n'est éliminé.
  */

  if (
    winners.length !== 1
  ) {

    await showTieResult();

    return;

  }


  const eliminatedId =
    winners[0];


  const eliminatedPlayer =
    players.find(
      player =>
        player.id ===
        eliminatedId
    );


  if (!eliminatedPlayer) {
    return;
  }


  /*
    Éliminer le joueur.
  */

  const {
    error
  } =
    await supabaseClient
      .from("players")
      .update({

        alive: false,

        eliminated: true,

        revealed: true

      })
      .eq(
        "id",
        eliminatedId
      )
      .eq(
        "game_id",
        gameId
      );


  if (error) {

    setStatus(
      "❌ " +
      error.message,
      "error"
    );

    return;

  }


  /*
    Vérifier la victoire.
  */

  await checkWinner(
    eliminatedPlayer
  );

}


/* =========================================================
   ÉGALITÉ
========================================================= */

async function showTieResult() {

  const {
    error
  } =
    await supabaseClient
      .from("games")
      .update({

        phase: "result",

        updated_at:
          new Date().toISOString()

      })
      .eq(
        "id",
        gameId
      );


  if (error) {
    console.error(error);
  }


  /*
    On affiche une égalité.
  */

  resultContent.innerHTML = `
    <div class="big">🤝</div>

    <p style="text-align:center;">
      Égalité !
    </p>

    <p style="text-align:center;">
      Personne n'est éliminé cette fois-ci.
    </p>
  `;


  resultCard.classList.remove(
    "hidden"
  );


  voteCard.classList.add(
    "hidden"
  );


  resolveButton.classList.add(
    "hidden"
  );


  hostNextButton.classList.remove(
    "hidden"
  );

}


/* =========================================================
   VÉRIFIER VICTOIRE
========================================================= */

async function checkWinner(
  eliminatedPlayer
) {

  await loadPlayers();


  const undercovers =
    players.filter(
      player =>
        player.role ===
        "undercover" &&
        player.alive !== false
    );


  const villagers =
    players.filter(
      player =>
        player.role !==
        "undercover" &&
        player.alive !== false
    );


  /*
    Si l'Undercover éliminé :
    village gagne.
  */

  if (
    eliminatedPlayer.role ===
    "undercover"
  ) {

    await finishGame(
      "villagers"
    );

    return;

  }


  /*
    S'il n'y a plus d'Undercover :
    village gagne.
  */

  if (
    undercovers.length === 0
  ) {

    await finishGame(
      "villagers"
    );

    return;

  }


  /*
    Si Undercover >= villageois :
    Undercover gagne.
  */

  if (
    undercovers.length >=
    villagers.length
  ) {

    await finishGame(
      "undercover"
    );

    return;

  }


  /*
    La partie continue.
  */

  const {
    error
  } =
    await supabaseClient
      .from("games")
      .update({

        phase: "result",

        updated_at:
          new Date().toISOString()

      })
      .eq(
        "id",
        gameId
      );


  if (error) {
    console.error(error);
  }


  await loadPlayers();


  const eliminated =
    players.find(
      player =>
        player.id ===
        eliminatedPlayer.id
    );


  resultContent.innerHTML = `

    <div class="big">
      ${eliminatedPlayer.role === "undercover"
        ? "🕵️"
        : "❌"}
    </div>

    <p style="text-align:center;">
      <strong>
        ${escapeHTML(
          eliminatedPlayer.name
        )}
      </strong>
      a été éliminé.
    </p>

    <p style="text-align:center;">
      Son rôle était :
    </p>

    <div
      style="
        text-align:center;
        font-size:24px;
        font-weight:bold;
      "
    >
      ${
        eliminatedPlayer.role ===
        "undercover"
          ? "🕵️ UNDERCOVER"
          : "👤 VILLAGEOIS"
      }
    </div>

  `;


  resultCard.classList.remove(
    "hidden"
  );


  hostNextButton.classList.remove(
    "hidden"
  );


  resolveButton.classList.add(
    "hidden"
  );

}


/* =========================================================
   FIN DE PARTIE
========================================================= */

async function finishGame(
  winner
) {

  const {
    error
  } =
    await supabaseClient
      .from("games")
      .update({

        phase: "ended",

        status: "finished",

        winner: winner,

        updated_at:
          new Date().toISOString()

      })
      .eq(
        "id",
        gameId
      );


  if (error) {

    console.error(error);

    return;

  }


  await loadPlayers();


  showWinner();

}


function showWinner() {

  setPhase(
    "🏆 Fin de la partie",
    "La partie est terminée."
  );


  noteCard.classList.remove(
    "hidden"
  );


  discussionCard.classList.add(
    "hidden"
  );


  voteCard.classList.add(
    "hidden"
  );


  resultCard.classList.add(
    "hidden"
  );


  winnerCard.classList.remove(
    "hidden"
  );


  const winner =
    currentGame.winner;


  if (
    winner ===
    "undercover"
  ) {

    winnerEmoji.textContent =
      "🕵️";

    winnerText.textContent =
      "Les Undercover ont gagné !";

  } else {

    winnerEmoji.textContent =
      "👥";

    winnerText.textContent =
      "Les villageois ont gagné !";

  }


  hostControls.classList.add(
    "hidden"
  );

}


/* =========================================================
   CONTINUER
========================================================= */

async function nextRound() {

  if (
    !currentPlayer.is_host
  ) {
    return;
  }


  await loadPlayers();


  /*
    Nettoyage des votes.
  */

  const {
    error: playerError
  } =
    await supabaseClient
      .from("players")
      .update({

        vote_for: null

      })
      .eq(
        "game_id",
        gameId
      )
      .eq(
        "alive",
        true
      );


  if (playerError) {

    setStatus(
      "❌ " +
      playerError.message,
      "error"
    );

    return;

  }


  const newRound =
    Number(
      currentGame.current_round ||
      currentGame.round ||
      1
    ) + 1;


  const {
    error
  } =
    await supabaseClient
      .from("games")
      .update({

        phase: "discussion",

        round: newRound,

        current_round: newRound,

        updated_at:
          new Date().toISOString()

      })
      .eq(
        "id",
        gameId
      );


  if (error) {

    setStatus(
      "❌ " +
      error.message,
      "error"
    );

  }

}


hostNextButton.addEventListener(
  "click",
  nextRound
);


nextRoundButton.addEventListener(
  "click",
  nextRound
);


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(value) {

  return String(value)
    .replace(
      /[&<>"']/g,
      function(char) {

        return {

          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"

        }[char];

      }
    );

}


/* =========================================================
   REALTIME
========================================================= */

function subscribeRealtime() {

  if (realtimeChannel) {

    supabaseClient.removeChannel(
      realtimeChannel
    );

  }


  realtimeChannel =
    supabaseClient
      .channel(
        "game-page-" +
        gameId
      )

      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "games",
          filter:
            "id=eq." +
            gameId
        },
        async function(payload) {

          currentGame =
            payload.new;


          await loadPlayers();


          /*
            Actualisation.
          */

          renderGame();


          setStatus(
            "🔄 Partie synchronisée",
            "success"
          );

        }
      )

      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "players",
          filter:
            "game_id=eq." +
            gameId
        },
        async function() {

          await loadPlayers();


          /*
            Récupère à nouveau
            le joueur courant.
          */

          const me =
            players.find(
              player =>
                player.id ===
                playerId
            );


          if (me) {

            currentPlayer =
              me;

          }


          renderGame();

        }
      )

      .subscribe();

}


/* =========================================================
   BOUTON HÔTE : TERMINER LES VOTES
========================================================= */

resolveButton.addEventListener(
  "click",
  resolveVotes
);


/* =========================================================
   INITIALISATION
========================================================= */

async function start() {

  try {

    setStatus(
      "Connexion à Supabase..."
    );


    await loadGame();


    /*
      L'hôte attribue les rôles.
    */

    if (
      currentPlayer &&
      currentPlayer.is_host &&
      currentGame &&
      currentGame.status ===
      "playing"
    ) {

      await initializeGame();


      /*
        Recharge après attribution.
      */

      const {
        data: updatedGame
      } =
        await supabaseClient
          .from("games")
          .select("*")
          .eq(
            "id",
            gameId
          )
          .maybeSingle();


      if (updatedGame) {

        currentGame =
          updatedGame;

      }


      await loadPlayers();


      const me =
        players.find(
          player =>
            player.id ===
            playerId
        );


      if (me) {

        currentPlayer =
          me;

      }


      renderGame();

    }


    setStatus(
      "✅ Partie chargée",
      "success"
    );


  } catch (error) {

    console.error(error);

    setStatus(
      "❌ " +
      error.message,
      "error"
    );

  }

}


start();


/* =========================================================
   NETTOYAGE
========================================================= */

window.addEventListener(
  "beforeunload",
  function() {

    if (realtimeChannel) {

      supabaseClient.removeChannel(
        realtimeChannel
      );

    }

  }
);

